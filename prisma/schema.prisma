generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  isVendor     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedSalons      Salon[]
  ownedRestaurants Restaurant[]
  appointments     Appointment[]
}

model Salon {
  id           String  @id @default(cuid())
  slug         String  @unique
  ownerId      String?
  owner        User?   @relation(fields: [ownerId], references: [id])
  name         String
  tagline      String
  area         String
  address      String
  lat          Float
  lng          Float
  categories   String // JSON-encoded string[]
  rating       Float
  reviewCount  Int
  priceLevel   Int
  imageSeed    String
  gallerySeeds String // JSON-encoded string[]
  about        String
  amenities    String // JSON-encoded string[]
  featured     Boolean @default(false)
  phone        String

  services     Service[]
  openHours    OpenHours[]
  reviews      Review[]
  appointments Appointment[]
  promotions   Promotion[]
}

model Restaurant {
  id           String  @id @default(cuid())
  slug         String  @unique
  ownerId      String?
  owner        User?   @relation(fields: [ownerId], references: [id])
  name         String
  tagline      String
  area         String
  address      String
  lat          Float
  lng          Float
  cuisines     String // JSON-encoded string[]
  rating       Float
  reviewCount  Int
  priceLevel   Int
  imageSeed    String
  gallerySeeds String // JSON-encoded string[]
  about        String
  amenities    String // JSON-encoded string[]
  partySizes   String // JSON-encoded number[]
  featured     Boolean @default(false)
  phone        String

  menuHighlights MenuHighlight[]
  openHours      OpenHours[]
  reviews        Review[]
  appointments   Appointment[]
  promotions     Promotion[]
}

model Service {
  id           String @id @default(cuid())
  salonId      String
  salon        Salon  @relation(fields: [salonId], references: [id], onDelete: Cascade)
  name         String
  category     String
  durationMins Int
  priceLKR     Int
  description  String

  appointments Appointment[]
}

model MenuHighlight {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  priceLKR     Int
  description  String
}

model OpenHours {
  id           String      @id @default(cuid())
  salonId      String?
  salon        Salon?      @relation(fields: [salonId], references: [id], onDelete: Cascade)
  restaurantId String?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  day          String // "Mon".."Sun"
  openMinutes  Int // minutes from midnight
  closeMinutes Int
}

model Promotion {
  id           String      @id @default(cuid())
  salonId      String?
  salon        Salon?      @relation(fields: [salonId], references: [id], onDelete: Cascade)
  restaurantId String?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  title        String
  description  String
  startDate    String? // ISO date "2026-08-01", null = starts immediately
  endDate      String? // ISO date, null = no end
  createdAt    DateTime    @default(now())
}

model Review {
  id           String      @id @default(cuid())
  salonId      String?
  salon        Salon?      @relation(fields: [salonId], references: [id], onDelete: Cascade)
  restaurantId String?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  author       String
  rating       Int
  date         DateTime
  comment      String
}

enum AppointmentKind {
  SALON
  RESTAURANT
}

enum AppointmentStatus {
  UPCOMING
  CANCELLED
  COMPLETED
}

model Appointment {
  id            String            @id @default(cuid())
  kind          AppointmentKind
  status        AppointmentStatus @default(UPCOMING)
  date          String // ISO date "2026-08-01"
  time          String // display label, e.g. "2:30 PM"
  startMinutes  Int // minutes from midnight, used for conflict checks
  customerId    String?
  customer      User?   @relation(fields: [customerId], references: [id])
  customerName  String
  customerPhone String
  notes         String?
  isManual      Boolean @default(false)
  createdAt     DateTime @default(now())

  // salon-kind fields (nullable, populated only when kind = SALON)
  salonId      String?
  salon        Salon?   @relation(fields: [salonId], references: [id])
  serviceId    String?
  service      Service? @relation(fields: [serviceId], references: [id])
  durationMins Int?
  priceLKR     Int?

  // restaurant-kind fields (nullable, populated only when kind = RESTAURANT)
  restaurantId String?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id])
  partySize    Int?
  cardLast4    String?

  @@index([salonId, date])
  @@index([restaurantId, date])
}
