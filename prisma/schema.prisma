generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  name         String
  phone        String?
  isVendor     Boolean  @default(false)
  googleId     String?  @unique
  facebookId   String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedSalons  Salon[]
  appointments Appointment[]
}

model Salon {
  id           String  @id @default(cuid())
  slug         String  @unique
  ownerId      String?
  owner        User?   @relation(fields: [ownerId], references: [id])
  name         String
  tagline      String
  area         String
  address      String
  lat          Float
  lng          Float
  categories   String // JSON-encoded string[]
  rating       Float
  reviewCount  Int
  priceLevel   Int
  imageSeed    String
  gallerySeeds String // JSON-encoded string[]

  // Real vendor-uploaded photos, stored as base64 data URLs. Null/empty means
  // no photo uploaded yet — falls back to the imageSeed/gallerySeeds gradient.
  coverImage    String?
  galleryImages String? // JSON-encoded string[]
  about        String
  amenities    String // JSON-encoded string[]
  featured     Boolean @default(false)
  phone        String

  // International format (e.g. "+94 77 123 4567"), used to build the
  // customer-facing "Chat on WhatsApp" wa.me link. Null until a vendor sets it.
  whatsappNumber String?

  // Vendor-pasted embed snippet for MioSalon's hosted booking widget. When
  // set, the public salon page shows this instead of the native booking flow.
  mioSalonEmbedCode String?

  cancellationFeeEnabled Boolean @default(false)
  cancellationFeePercent Int     @default(20)

  noShowFeeEnabled Boolean @default(false)
  noShowFeePercent Int     @default(20)

  services     Service[]
  openHours    OpenHours[]
  reviews      Review[]
  appointments Appointment[]
  promotions   Promotion[]
  teamMembers  TeamMember[]
  pricingRules PricingRule[]
  bills        Bill[]
}

model Service {
  id           String @id @default(cuid())
  salonId      String
  salon        Salon  @relation(fields: [salonId], references: [id], onDelete: Cascade)
  name         String
  category     String
  durationMins Int
  priceLKR     Int
  description  String

  appointments Appointment[]
  teamMembers  TeamMember[] @relation("TeamMemberServices")
  pricingRules PricingRule[] @relation("PricingRuleServices")
}

model OpenHours {
  id           String @id @default(cuid())
  salonId      String?
  salon        Salon? @relation(fields: [salonId], references: [id], onDelete: Cascade)
  day          String // "Mon".."Sun"
  openMinutes  Int // minutes from midnight
  closeMinutes Int
}

model TeamMember {
  id        String   @id @default(cuid())
  salonId   String
  salon     Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  name      String
  role      String?
  createdAt DateTime @default(now())

  services     Service[]         @relation("TeamMemberServices")
  hours        TeamMemberHours[]
  appointments Appointment[]
}

model TeamMemberHours {
  id           String     @id @default(cuid())
  teamMemberId String
  teamMember   TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  day          String // "Mon".."Sun"
  openMinutes  Int // minutes from midnight
  closeMinutes Int
}

model Promotion {
  id          String   @id @default(cuid())
  salonId     String?
  salon       Salon?   @relation(fields: [salonId], references: [id], onDelete: Cascade)
  title       String
  description String
  startDate   String? // ISO date "2026-08-01", null = starts immediately
  endDate     String? // ISO date, null = no end
  createdAt   DateTime @default(now())
}

enum PricingRuleType {
  DISCOUNT
  SURCHARGE
}

enum PricingRuleAmountType {
  PERCENT
  FLAT
}

// A vendor-defined recurring day/time pricing adjustment (off-peak discount
// or busy-period surcharge). Scoped to either all services or a specific
// subset. See src/lib/pricing.ts for how a rule is matched and applied.
model PricingRule {
  id                   String                @id @default(cuid())
  salonId              String
  salon                Salon                 @relation(fields: [salonId], references: [id], onDelete: Cascade)
  label                String
  type                 PricingRuleType
  amountType           PricingRuleAmountType
  amount               Int // percent (1-100) if PERCENT, LKR if FLAT
  days                 String // JSON-encoded string[] subset of Mon..Sun
  startMinutes         Int // minutes from midnight
  endMinutes           Int
  appliesToAllServices Boolean               @default(true)
  services             Service[]             @relation("PricingRuleServices")
  enabled              Boolean               @default(true)
  createdAt            DateTime              @default(now())
}

model Review {
  id      String @id @default(cuid())
  salonId String?
  salon   Salon? @relation(fields: [salonId], references: [id], onDelete: Cascade)
  author  String
  rating  Int
  date    DateTime
  comment String
}

enum AppointmentKind {
  SALON
}

enum AppointmentStatus {
  UPCOMING
  CHECKED_IN // vendor marked the client as arrived, not yet billed
  NO_SHOW // vendor marked the client as a no-show, not yet billed
  CANCELLED
  COMPLETED // a Bill has been generated for this appointment
}

model Appointment {
  id            String            @id @default(cuid())
  kind          AppointmentKind
  status        AppointmentStatus @default(UPCOMING)
  date          String // ISO date "2026-08-01"
  time          String // display label, e.g. "2:30 PM"
  startMinutes  Int // minutes from midnight, used for conflict checks
  customerId    String?
  customer      User?   @relation(fields: [customerId], references: [id])
  customerName  String
  customerPhone String
  notes         String?
  isManual      Boolean @default(false)
  createdAt     DateTime @default(now())

  // salon-kind fields (nullable, populated only when kind = SALON)
  salonId      String?
  salon        Salon?   @relation(fields: [salonId], references: [id])
  serviceId    String?
  service      Service? @relation(fields: [serviceId], references: [id])
  durationMins Int?
  priceLKR     Int?
  teamMemberId String?
  teamMember   TeamMember? @relation(fields: [teamMemberId], references: [id], onDelete: SetNull)

  // Price breakdown snapshot — basePriceLKR is the service price before any
  // pricing rule, appliedRuleLabel names the rule if one matched (both null
  // for legacy appointments predating this feature). cancellationFeeLKR is
  // set only when the customer (not the vendor) cancels and a fee applies.
  basePriceLKR       Int?
  appliedRuleLabel   String?
  cancellationFeeLKR Int?

  bill Bill?

  @@index([salonId, date])
}

// A finalized, immutable receipt generated by the vendor once a customer has
// checked in (or been marked a no-show) and the bill is confirmed. Line
// items are a JSON snapshot rather than a relational table — a Bill is
// always read/edited as a whole with its appointment, never queried
// per-line-item, and this convention (categories, galleryImages, days on
// other models) is already the norm for small always-together arrays here.
model Bill {
  id            String      @id @default(cuid())
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  salonId       String
  salon         Salon       @relation(fields: [salonId], references: [id], onDelete: Cascade)

  customerName  String
  customerPhone String
  customerEmail String? // null for manual/walk-in bookings with no linked User

  lineItems String // JSON-encoded BillLineItem[], see src/lib/billing.ts
  totalLKR  Int

  emailSentAt    DateTime?
  whatsappSentAt DateTime?
  createdAt      DateTime  @default(now())

  @@index([salonId, createdAt])
}
